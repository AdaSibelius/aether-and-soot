{
  "name": "aether-and-soot",
  "version": "0.1.0",
  "private": true,
  "description": "Victorian Steampunk 2D Emergent Roguelike (CDDA Simulation Depth + Caves of Qud Glyph/Shader Aesthetics)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:sim": "vitest run",
    "test:watch": "vitest",
    "validate:data": "tsx tests/scripts/validate-data.ts",
    "check:boundaries": "tsx tests/scripts/check-boundaries.ts",
    "playtest": "tsx tests/scripts/llm-playtester.ts",
    "playtest:mock": "tsx tests/scripts/llm-playtester.ts --mock",
    "generate:content": "tsx tests/scripts/hermes-content-generator.ts",
    "generate:content:mock": "tsx tests/scripts/hermes-content-generator.ts --mock",
    "hermes:scout": "tsx tests/scripts/hermes-scout.ts",
    "hermes:scout:mock": "tsx tests/scripts/hermes-scout.ts --mock",
    "hermes:chronicler": "tsx tests/scripts/hermes-chronicler.ts",
    "hermes:chronicler:mock": "tsx tests/scripts/hermes-chronicler.ts --mock",
    "hermes:testgen": "tsx tests/scripts/hermes-testgen.ts",
    "hermes:testgen:mock": "tsx tests/scripts/hermes-testgen.ts --mock",
    "hermes:split": "tsx tests/scripts/hermes-split.ts",
    "hermes:split:mock": "tsx tests/scripts/hermes-split.ts --mock",
    "hermes:critic": "tsx tests/scripts/hermes-critic.ts",
    "hermes:critic:mock": "tsx tests/scripts/hermes-critic.ts --mock",
    "scaffold:mechanic": "tsx tests/scripts/scaffold-mechanic.ts",
    "scaffold:mechanic:mock": "tsx tests/scripts/scaffold-mechanic.ts --mock",
    "generate:arch-map": "tsx tests/scripts/generate-architecture-map.ts",
    "sync:state": "tsx tests/scripts/update-state.ts",
    "verify": "npm run typecheck && npm run check:boundaries && npm run validate:data && npm run test:sim"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "preact": "^10.25.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
